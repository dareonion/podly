<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Podly" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <!--
      MediaRouteButton is an AppCompat view and cannot inflate against
      Theme.Podly (a framework Material theme), so the cast button wraps its
      context in this one. Tinted for the app's dark player surface.
    -->
    <style name="Theme.Podly.Cast" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorControlNormal">@android:color/white</item>
        <!-- Theme.AppCompat doesn't carry mediarouter's attrs; without this the
             button has no cast drawable to inflate. -->
        <item name="mediaRouteButtonStyle">@style/Widget.MediaRouter.MediaRouteButton</item>
    </style>
</resources>
