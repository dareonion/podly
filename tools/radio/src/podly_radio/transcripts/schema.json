{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "paragraphs",
    "changes",
    "notes"
  ],
  "properties": {
    "paragraphs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "start",
          "text"
        ],
        "properties": {
          "start": {
            "type": "string",
            "pattern": "^\\d{2,}:[0-5]\\d:[0-5]\\d\\.\\d{3}$"
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "original",
          "corrected",
          "reason",
          "confidence"
        ],
        "properties": {
          "original": {
            "type": "string"
          },
          "corrected": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "sure",
              "likely"
            ]
          }
        }
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
